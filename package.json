{
  "name": "pi-personal-extensions",
  "version": "0.1.0",
  "description": "个人维护的 Pi 扩展合集",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-personal-extensions.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
